# Скопируйте: cp .env.example .env
# Docker Compose читает .env и поднимает PostgreSQL + API в контейнерах.

# --- PostgreSQL (контейнер db) ---
POSTGRES_USER=task_admin
POSTGRES_PASSWORD=task_secret
POSTGRES_DB=task_management_dev
POSTGRES_PORT=5433

# --- Только если запускаете API на Mac без Docker (uvicorn) ---
# Postgres при этом должен быть доступен на localhost:POSTGRES_PORT (после docker compose up db)
DATABASE_URL=postgresql+asyncpg://task_admin:task_secret@localhost:5433/task_management_dev
DATABASE_URL_SYNC=postgresql://task_admin:task_secret@localhost:5433/task_management_dev

API_PORT=8000

# --- Безопасность ---
SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Приложение ---
APP_NAME=Task Management API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
PORT=8000

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Default admin seed (created on startup if user does not exist)
SEED_DEFAULT_ADMIN=True
# development: sync password from .env on each restart (so login matches DEFAULT_ADMIN_PASSWORD)
SEED_DEFAULT_ADMIN_SYNC_PASSWORD=True
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AdminChangeMe123!
DEFAULT_ADMIN_FULL_NAME=Default Admin

# Optional: comma-separated emails of existing users to also promote to admin
ADMIN_EMAILS=

# --- Email (опционально) ---
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@taskmanagement.com
EMAILS_FROM_NAME=Task Management API
